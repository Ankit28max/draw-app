# ==============================================================================
# VectorCraft Production Environment Configuration
# ==============================================================================

# Database Connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vectorcraft?schema=public"

# Authentication Security (MANDATORY IN PRODUCTION)
# Generate a strong 256-bit secret: `openssl rand -base64 32`
JWT_SECRET="generate-a-secure-random-256-bit-key-for-production"

# Allowed CORS Origins (comma-separated for multiple domains)
CORS_ORIGIN="https://yourdomain.com,http://localhost:3000"

# Service Ports
HTTP_PORT=3001
WS_PORT=8080
FRONTEND_PORT=3000

# Next.js Client-Side Environment Variables (Exposed to browser)
# Replace with your production domain (use wss:// and https:// in production)
NEXT_PUBLIC_HTTP_BACKEND="https://api.yourdomain.com"
NEXT_PUBLIC_WS_URL="wss://ws.yourdomain.com"
